# Generated by dl. Every project domain gets a virtual host.
#
# Each host carries a <Directory> block because apache2.conf denies everything outside
# /var/www/ ("<Directory />: Require all denied"), so a document root elsewhere would
# answer 403 while the container starts cleanly. AllowOverride is left alone: the image
# already grants All for /var/www/ through conf-enabled/docker-php.conf.
{{ range $i, $d := .Domains }}
<VirtualHost *:80>
    ServerName {{ $d.LocalDomain }}
    ServerAlias *.{{ $d.LocalDomain }}
    ServerAlias {{ $d.NipDomain }}
    ServerAlias *.{{ $d.NipDomain }}

    DocumentRoot {{ $d.DocumentRoot }}

    <Directory {{ $d.DocumentRoot }}>
        Require all granted
    </Directory>
</VirtualHost>
{{ end -}}
